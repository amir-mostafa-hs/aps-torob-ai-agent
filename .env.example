# ==============================================================================
# Torob In-Person Shopping Assistant - Production Environment Variables
# ==============================================================================

# LLM Provider Configuration
# Choose: 'boxapi' (Production), 'gemini' (Development), or 'mock' (Offline Testing)
LLM_PROVIDER=boxapi

# BoxAPI (Production URL supplied by challenge: https://ai.boxapi.ir/ai/v1)
BOXAPI_BASE_URL=https://ai.boxapi.ir/ai/v1
BOXAPI_API_KEY=your_boxapi_api_key_here
BOXAPI_MODEL=gpt-5-mini

# Google AI Studio / Gemini (Development / Fallback)
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Backend Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=false
CORS_ORIGINS=*

# Anonymous Session Store
SESSION_TTL_HOURS=4

# Frontend Configuration (for Next.js)
# In production, set to your backend deployment URL, e.g. https://api-torob.liara.run
# If empty, Next.js will use relative paths /api/* via built-in proxy rewrites.
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_INTERNAL_URL=http://localhost:8000
